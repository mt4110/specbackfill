{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mt4110/specbackfill/blob/main/schemas/obligations.schema.json",
  "title": "specbackfill obligations artifact",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "run",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "obligations.v1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "specbackfill"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "input_kind",
        "base",
        "head",
        "diff_fingerprint"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "input_kind": {
          "type": "string",
          "enum": [
            "working_tree",
            "range",
            "diff_file"
          ]
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "diff_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "finding_id",
          "omission_signature",
          "rule_id",
          "rule_version",
          "status",
          "severity",
          "confidence",
          "title",
          "why",
          "diff_local_claim",
          "anchor",
          "required_companions",
          "evidence",
          "suppression",
          "downstream"
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "omission_signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "rule_version": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "diff_local_claim": {
            "const": true
          },
          "anchor": {
            "type": "object",
            "required": [
              "kind",
              "path",
              "line",
              "evidence"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            "additionalProperties": false
          },
          "required_companions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "status",
                "satisfiers",
                "expected_paths"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/status"
                },
                "satisfiers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expected_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "suppression": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            "additionalProperties": false
          },
          "downstream": {
            "type": "object",
            "required": [
              "import_kind",
              "source_signal"
            ],
            "properties": {
              "import_kind": {
                "const": "deterministic_static_layer"
              },
              "source_signal": {
                "const": "specbackfill"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "satisfied",
        "missing",
        "unknown",
        "suppressed"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "file",
        "excerpt"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
